  },
  "devDependencies": {
    "@speedrunledger/appview": "workspace:*",
    "@speedrunledger/community-service": "workspace:*",
    "@speedrunledger/indexer": "workspace:*",
    "@speedrunledger/runner-web": "workspace:*",
    "@speedrunledger/testkit": "workspace:*",
    "@types/express": "5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
