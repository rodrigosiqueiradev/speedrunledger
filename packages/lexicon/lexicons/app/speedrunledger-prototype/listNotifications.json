{
  "lexicon": 1,
  "id": "app.speedrunledger-prototype.listNotifications",
  "defs": {
    "main": {
      "type": "query",
      "description": "What happened to an account's runs and communities, newest first: verdicts, world records won and lost, flags, invitations, and proposals waiting for its vote.",
      "parameters": {
        "type": "params",
        "required": [
          "actor"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "notifications"
          ],
          "properties": {
            "notifications": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "app.speedrunledger-prototype.defs#notificationView"
              }
            }
          }
        }
      }
    }
  }
}
