{
  "lexicon": 1,
  "id": "app.speedrunledger-prototype.platform.sysadmin",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "Lists a sysadmin. Only records in the platform account's repo count; the record key is the sysadmin's DID.",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
