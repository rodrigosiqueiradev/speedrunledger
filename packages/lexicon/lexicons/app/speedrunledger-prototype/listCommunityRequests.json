{
  "lexicon": 1,
  "id": "app.speedrunledger-prototype.listCommunityRequests",
  "defs": {
    "main": {
      "type": "query",
      "description": "Requests for new communities, oldest first.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "status": {
            "type": "string",
            "knownValues": [
              "pending",
              "all"
            ],
            "default": "pending"
          },
          "requester": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "app.speedrunledger-prototype.defs#requestView"
              }
            }
          }
        }
      }
    }
  }
}
