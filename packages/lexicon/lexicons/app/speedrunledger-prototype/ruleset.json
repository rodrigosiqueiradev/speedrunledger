{
  "lexicon": 1,
  "id": "app.speedrunledger-prototype.ruleset",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Rules text for a category. A new version is a new record; the newest one is current.",
      "record": {
        "type": "object",
        "required": [
          "category",
          "text",
          "createdAt"
        ],
        "properties": {
          "category": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "text": {
            "type": "string",
            "maxLength": 200000,
            "maxGraphemes": 20000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
