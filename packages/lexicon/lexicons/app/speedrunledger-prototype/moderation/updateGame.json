{
  "lexicon": 1,
  "id": "app.speedrunledger-prototype.moderation.updateGame",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Served by the community service. Rewrites a game record of the caller's community; any active moderator can edit game details without a vote.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "game"
          ],
          "properties": {
            "game": {
              "type": "string",
              "format": "at-uri"
            },
            "title": {
              "type": "string",
              "maxLength": 1000,
              "maxGraphemes": 100
            },
            "releaseYear": {
              "type": "integer",
              "minimum": 1950,
              "maximum": 2100
            },
            "platforms": {
              "type": "array",
              "maxLength": 50,
              "items": {
                "type": "string",
                "maxLength": 640,
                "maxGraphemes": 64
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "uri",
            "cid"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "cid": {
              "type": "string",
              "format": "cid"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotModerator"
        },
        {
          "name": "Banned"
        },
        {
          "name": "CommunityFrozen"
        },
        {
          "name": "CommunityNotManaged"
        },
        {
          "name": "GameNotFound"
        }
      ]
    }
  }
}
