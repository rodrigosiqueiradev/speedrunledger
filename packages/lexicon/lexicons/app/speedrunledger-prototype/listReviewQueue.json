{
  "lexicon": 1,
  "id": "app.speedrunledger-prototype.listReviewQueue",
  "defs": {
    "main": {
      "type": "query",
      "description": "Runs in a community waiting for a verdict on their current version, oldest first. Runs that fail the category's checks are left out; they cannot be verified until the runner fixes them.",
      "parameters": {
        "type": "params",
        "required": ["community"],
        "properties": {
          "community": { "type": "string", "format": "did" },
          "category": { "type": "string", "format": "at-uri", "description": "Only this category." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["runs"],
          "properties": {
            "runs": {
              "type": "array",
              "items": { "type": "ref", "ref": "app.speedrunledger-prototype.defs#queueItem" }
            },
            "cursor": { "type": "string" }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    }
  }
}
