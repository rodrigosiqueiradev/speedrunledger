{
  "lexicon": 1,
  "id": "app.speedrunledger-prototype.community.ban",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Excludes a DID from this community's boards. Any single moderator can ban; a majority vote lifts it.",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "reason",
          "moderator",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did"
          },
          "reason": {
            "type": "string",
            "maxLength": 10000,
            "maxGraphemes": 1000
          },
          "moderator": {
            "type": "string",
            "format": "did"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
